# Local demo uses SQLite by default. To use Neon Postgres, set DATABASE_URL.
DATABASE_URL=sqlite:///./data/purchasing.db
# Example only: copy the connection string from Neon into your ignored local .env file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Destructive reset endpoints are disabled for remote databases unless explicitly enabled.
ALLOW_DATABASE_RESET=false

# Optional LangChain purchasing decision agent. Leave as "none" for offline mode.
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# Purchasing policy
APPROVAL_THRESHOLD=500.00
SAFETY_STOCK_DAYS=1
REVIEW_HORIZON_DAYS=1
STALE_FORECAST_HOURS=72
DEMAND_SPIKE_THRESHOLD=0.25
MAX_AGENT_RETRIES=2

# Demo
DEMO_APPROVER=buyer.demo
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
